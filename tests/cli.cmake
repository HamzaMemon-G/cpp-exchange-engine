set(dir "${CMAKE_CURRENT_BINARY_DIR}/cli-fixtures")
file(MAKE_DIRECTORY "${dir}")
execute_process(COMMAND "${CLI}" --input "${SOURCE}/examples/commands.txt" RESULT_VARIABLE rc OUTPUT_VARIABLE sample)
file(READ "${SOURCE}/examples/expected-output.txt" expected)
string(REPLACE "\r\n" "\n" expected "${expected}")
if(NOT rc EQUAL 0 OR NOT sample STREQUAL expected)
  message(FATAL_ERROR "documented sample output differs")
endif()
set(log "${dir}/events.log")
file(CONFIGURE OUTPUT "${log}" CONTENT "EXCHANGE_LOG_V1\n" NEWLINE_STYLE UNIX)
file(WRITE "${dir}/input.txt" "ADD 1 SELL 100 10\nADD 2 BUY 101 4\nADD 1 BUY 99 1\nCANCEL 999\nBAD\nBOOK\n")
execute_process(COMMAND "${CLI}" --input "${dir}/input.txt" --log "${log}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 2 OR NOT out MATCHES "DUPLICATE_ID" OR NOT out MATCHES "UNKNOWN_ID" OR NOT err MATCHES "ERROR line=5")
  message(FATAL_ERROR "CLI error handling failed: ${rc} ${out} ${err}")
endif()
execute_process(COMMAND "${CLI}" --replay "${log}" RESULT_VARIABLE rc OUTPUT_VARIABLE replay)
if(NOT rc EQUAL 0 OR NOT replay STREQUAL "BOOK sequence=4\nSELL price=100 remaining=6 id=1 sequence=1\nEND_BOOK\n")
  message(FATAL_ERROR "CLI replay failed: ${rc} ${replay}")
endif()
file(WRITE "${dir}/continue.txt" "CANCEL 1\nBOOK\n")
execute_process(COMMAND "${CLI}" --log "${log}" INPUT_FILE "${dir}/continue.txt" RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT rc EQUAL 0 OR NOT out MATCHES "BOOK sequence=5\nEND_BOOK")
  message(FATAL_ERROR "stdin or append resume failed: ${out}")
endif()
file(APPEND "${log}" "6\tCANCEL 1")
file(READ "${log}" before)
execute_process(COMMAND "${CLI}" --log "${log}" --input "${dir}/continue.txt" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(READ "${log}" after)
if(NOT rc EQUAL 1 OR NOT before STREQUAL after OR NOT err MATCHES "truncated log")
  message(FATAL_ERROR "truncation fail closed failed")
endif()
execute_process(COMMAND "${CLI}" --log "${log}" --input "${log}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 1 OR NOT err MATCHES "input and log must be different")
  message(FATAL_ERROR "input/log alias was not rejected")
endif()
set(missing "${dir}/never-created-input.txt")
execute_process(COMMAND "${CLI}" --input "${missing}" --log "${missing}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 1 OR EXISTS "${missing}" OR NOT err MATCHES "cannot open input file")
  message(FATAL_ERROR "missing input must fail before creating a journal")
endif()

# Immediate orders retain old command output and add explicit expiration lines.
file(WRITE "${dir}/immediate.txt" "ADD 1 SELL 100 5\nADD 2 SELL 101 4\nIOC 3 BUY 100 7\nMARKET 4 BUY 10\nMARKET 5 SELL 2\nCANCEL 3\nADD 4 BUY 99 1\nBOOK\n")
set(v2 "${dir}/immediate.log")
file(REMOVE "${v2}")
execute_process(COMMAND "${CLI}" --input "${dir}/immediate.txt" --log "${v2}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
set(expected "RESULT sequence=1 id=1 status=ACCEPTED\nRESULT sequence=2 id=2 status=ACCEPTED\nRESULT sequence=3 id=3 status=ACCEPTED\nTRADE sequence=3 maker=1 taker=3 price=100 quantity=5\nEXPIRED sequence=3 id=3 quantity=2\nRESULT sequence=4 id=4 status=ACCEPTED\nTRADE sequence=4 maker=2 taker=4 price=101 quantity=4\nEXPIRED sequence=4 id=4 quantity=6\nRESULT sequence=5 id=5 status=ACCEPTED\nEXPIRED sequence=5 id=5 quantity=2\nRESULT sequence=6 id=3 status=UNKNOWN_ID\nRESULT sequence=7 id=4 status=DUPLICATE_ID\nBOOK sequence=7\nEND_BOOK\n")
if(NOT rc EQUAL 2 OR NOT out STREQUAL expected OR NOT err STREQUAL "")
  message(FATAL_ERROR "immediate CLI output differs: ${rc} ${out} ${err}")
endif()
file(READ "${v2}" journal)
if(NOT journal MATCHES "^EXCHANGE_LOG_V2\n")
  message(FATAL_ERROR "new CLI journal is not V2")
endif()
execute_process(COMMAND "${CLI}" --replay "${v2}" RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT rc EQUAL 0 OR NOT out STREQUAL "BOOK sequence=7\nEND_BOOK\n")
  message(FATAL_ERROR "immediate CLI replay differs")
endif()
file(CONFIGURE OUTPUT "${dir}/legacy.log" CONTENT "EXCHANGE_LOG_V1\n1\tADD 10 SELL 100 5\n" NEWLINE_STYLE UNIX)
file(WRITE "${dir}/ioc.txt" "IOC 11 BUY 100 7\nBOOK\n")
file(READ "${dir}/legacy.log" legacy)
execute_process(COMMAND "${CLI}" --log "${dir}/legacy.log" --input "${dir}/ioc.txt"
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(READ "${dir}/legacy.log" after)
if(NOT rc EQUAL 1 OR NOT legacy STREQUAL after OR NOT err MATCHES "V1 journal supports only ADD/CANCEL")
  message(FATAL_ERROR "V1 journal must refuse IOC before append")
endif()
set(upgraded "${dir}/upgraded.log")
file(REMOVE "${upgraded}")
execute_process(COMMAND "${CLI}" --upgrade-log "${dir}/legacy.log" --output-log "${upgraded}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(READ "${dir}/legacy.log" after)
if(NOT rc EQUAL 0 OR NOT out MATCHES "UPGRADED journal=" OR NOT legacy STREQUAL after)
  message(FATAL_ERROR "CLI journal upgrade failed: ${rc} ${err}")
endif()
execute_process(COMMAND "${CLI}" --log "${upgraded}" --input "${dir}/ioc.txt"
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT out MATCHES "EXPIRED sequence=2 id=11 quantity=2\nBOOK sequence=2\nEND_BOOK")
  message(FATAL_ERROR "upgraded journal resume failed: ${rc} ${out} ${err}")
endif()
file(READ "${upgraded}" before)
execute_process(COMMAND "${CLI}" --upgrade-log "${dir}/legacy.log" --output-log "${upgraded}"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
file(READ "${upgraded}" after)
if(NOT rc EQUAL 1 OR NOT before STREQUAL after OR NOT err MATCHES "destination already exists")
  message(FATAL_ERROR "upgrade overwrote an existing destination")
endif()
execute_process(COMMAND "${CLI}" --upgrade-log "${dir}/legacy.log" --input "${dir}/ioc.txt"
  RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 1 OR NOT err MATCHES "upgrade requires")
  message(FATAL_ERROR "invalid upgrade options accepted")
endif()
